# Configuración de App Foundry.
#
# Copia este fichero a `.env` y rellena lo que falte. Las variables sin valor
# aquí son obligatorias: la aplicación no arranca sin ellas, a propósito.
#
#   cp .env.example .env

NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Dos URLs distintas y no es un descuido: la aplicación se conecta con un rol
# sin BYPASSRLS y las migraciones con uno privilegiado. Si ambas usaran el mismo
# rol, el aislamiento entre workspaces dejaría de ser una garantía del motor.
DATABASE_URL=postgres://app_user:app_local_dev@localhost:5432/app_foundry
DATABASE_MIGRATION_URL=postgres://foundry_migrator:foundry_local_dev@localhost:5432/app_foundry

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Autenticación con GitHub
# ---------------------------------------------------------------------------
# Crea una OAuth App en https://github.com/settings/developers
# URL de callback para desarrollo: http://localhost:3001/api/v1/auth/github/callback
# Permisos necesarios: solo identificación (read:user y user:email).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Tu usuario de GitHub, para recibir el rol de administrador al darte de alta.
BOOTSTRAP_ADMIN_GITHUB_LOGIN=

# ---------------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------------
# Genera uno con:  openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=30
INVITATION_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Notificaciones
# ---------------------------------------------------------------------------
# Un buzón que solo crece deja de leerse: las leídas se purgan pasados estos
# días y cada usuario conserva como mucho este número.
NOTIF_RETENTION_DAYS=30
NOTIF_MAX_PER_USER=500

# ---------------------------------------------------------------------------
# Inteligencia artificial (v2)
# ---------------------------------------------------------------------------
# Toda la IA es opcional: sin llavero, App Foundry funciona entera y lo único
# que no se puede es guardar la credencial de un proveedor.
#
# El llavero cifra esas credenciales. Formato `version:clave en base64`,
# separando por comas, y 32 bytes por clave. Se cifra con la versión más alta y
# se descifra con cualquiera, que es lo que permite rotar sin parar el servicio:
# se añade una versión nueva y se recifra en lote sin prisa.
#
# Para generar una:  openssl rand -base64 32
# AI_CREDENTIAL_KEYS=1:cambia+esto+por+treinta+y+dos+bytes+reales=

# Cuánto vive el catálogo de modelos antes de volver a preguntarle al proveedor.
# Cambia poco, así que un día es de sobra.
AI_MODEL_CATALOG_TTL_HOURS=24

# Cuántas invocaciones de IA puede provocar un miembro por hora. Acota el ritmo,
# no el volumen: para el volumen está el cupo de tokens de cada proveedor.
AI_MAX_INVOCATIONS_PER_MEMBER_HOUR=60

# Topes de instancia. El de agentes existe porque una revisión los invoca a
# todos de un gesto; el de turnos, para que una conversación no se eternice.
AI_MAX_AGENTS_PER_APP=5
AI_MAX_AGENT_TURNS_PER_THREAD=3

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
# Requiere el perfil obs:  docker compose --profile obs up -d
# Grafana queda en http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=app-foundry-api
OTEL_ENABLED=true
