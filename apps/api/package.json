{
  "name": "@app-foundry/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --import ./dist/observability/telemetry.js dist/main.js",
    "start": "node --import ./dist/observability/telemetry.js dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "openapi:export": "node dist/openapi.js"
  },
  "dependencies": {
    "@app-foundry/core": "workspace:*",
    "@app-foundry/db": "workspace:*",
    "@app-foundry/env": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.11.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-opentelemetry-transport": "4.0.2",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@app-foundry/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "typescript": "6.0.3"
  }
}
