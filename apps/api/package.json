{
  "name": "@app-foundry/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --import ./dist/observability/telemetry.js dist/main.js",
    "start": "node --import ./dist/observability/telemetry.js dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "openapi:export": "node dist/openapi.js",
    "test:api": "vitest run",
    "ai:rotate": "tsx src/ai/rotate-keys.ts"
  },
  "dependencies": {
    "@app-foundry/ai": "workspace:*",
    "@app-foundry/ai-runtime": "workspace:*",
    "@app-foundry/core": "workspace:*",
    "@app-foundry/db": "workspace:*",
    "@app-foundry/env": "workspace:*",
    "@app-foundry/notifications": "workspace:*",
    "@app-foundry/platform": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "bullmq": "5.66.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.11.1",
    "passport": "0.7.0",
    "passport-oauth2": "1.8.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-opentelemetry-transport": "4.0.2",
    "pino-pretty": "13.1.3",
    "rate-limiter-flexible": "11.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@app-foundry/config": "workspace:*",
    "@nestjs/testing": "12.0.1",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/passport-oauth2": "1.8.0",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
