{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/github": {
      "get": {
        "operationId": "AuthController_signIn",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Iniciar sesión con GitHub",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Cerrar sesión",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserDto"
                }
              }
            }
          }
        },
        "summary": "Quién soy",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "operationId": "WorkspacesController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkspaceDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Workspaces a los que pertenezco",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/v1/workspaces/{id}": {
      "patch": {
        "operationId": "WorkspacesController_rename",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameWorkspaceDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceDto"
                }
              }
            }
          }
        },
        "summary": "Renombrar un workspace propio",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/v1/workspaces/{id}/members": {
      "get": {
        "operationId": "WorkspacesController_members",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemberDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Miembros del workspace",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/v1/workspaces/{id}/members/{userId}": {
      "delete": {
        "operationId": "WorkspacesController_removeMember",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Expulsar a un miembro",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/v1/workspaces/{id}/leave": {
      "post": {
        "operationId": "WorkspacesController_leave",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Abandonar un workspace ajeno",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/v1/workspaces/{id}/invitations": {
      "get": {
        "operationId": "WorkspacesController_invitations",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InvitationDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Invitaciones del workspace",
        "tags": [
          "workspaces"
        ]
      },
      "post": {
        "description": "La respuesta es idéntica exista o no una cuenta con ese email: invitar no sirve para averiguar quién usa la plataforma.",
        "operationId": "WorkspacesController_invite",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationDto"
                }
              }
            }
          }
        },
        "summary": "Invitar por email",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/v1/workspaces/invitations/{invitationId}": {
      "delete": {
        "operationId": "WorkspacesController_revoke",
        "parameters": [
          {
            "name": "invitationId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Revocar una invitación",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessDto"
                }
              }
            }
          }
        },
        "summary": "Liveness: el proceso responde",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReportDto"
                }
              }
            }
          },
          "503": {
            "description": "Alguna dependencia falla",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReportDto"
                }
              }
            }
          }
        },
        "summary": "Readiness: las dependencias responden",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "App Foundry API",
    "description": "Un espacio para pensar, definir y traquear ideas de aplicaciones",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "handle": {
            "type": "string",
            "description": "Nombre de usuario de GitHub, usado en las menciones"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "platformRole": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          }
        },
        "required": [
          "id",
          "handle",
          "email",
          "displayName",
          "avatarUrl",
          "platformRole"
        ]
      },
      "WorkspaceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "Rol de quien consulta en este workspace",
            "enum": [
              "OWNER",
              "MEMBER"
            ]
          },
          "isPersonal": {
            "type": "boolean",
            "description": "Si es el workspace personal de su dueño"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role",
          "isPersonal"
        ]
      },
      "RenameWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ]
      },
      "MemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "MEMBER"
            ]
          }
        },
        "required": [
          "userId",
          "handle",
          "displayName",
          "avatarUrl",
          "role"
        ]
      },
      "InvitationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REVOKED",
              "EXPIRED"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "expiresAt",
          "createdAt"
        ]
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email de la persona a invitar"
          }
        },
        "required": [
          "email"
        ]
      },
      "DependencyCheckDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "Estado de la dependencia"
          },
          "latencyMs": {
            "type": "number",
            "description": "Tiempo de respuesta en milisegundos",
            "example": 12
          },
          "error": {
            "type": "string",
            "description": "Motivo del fallo, si lo hubo"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ]
      },
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyCheckDto"
            },
            "description": "Una entrada por dependencia comprobada"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      }
    }
  }
}
